# Genel
LM_ENV=dev
LM_LOG_LEVEL=INFO

# Şebekeye satış tarifesi (₺/kWh) — panelde üretimin para karşılığı bundan hesaplanır.
# Tesis bazında farklıysa arayüzdeki tesis formundan ayrıca girilebilir.
LM_DEFAULT_TARIFF_TRY_KWH=2.9

# PostgreSQL (Faz 2)
POSTGRES_PASSWORD=changeme
POSTGRES_DSN=postgresql+asyncpg://luminmind:changeme@postgres:5432/luminmind

# InfluxDB (Faz 2)
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=luminmind
INFLUX_TOKEN=changeme
INFLUX_PASSWORD=changeme123

# Redis / Celery
REDIS_URL=redis://redis:6379/0
INGESTION_INTERVAL_MINUTES=15

# --- Dijital ikiz / üretim tahmini ---
# Bugüne ek olarak kaç gün ileri tahmin üretilsin (arbitraj planı D+1'i kullanır).
LM_TWIN_HORIZON_DAYS=2
# Çok modelli hava tahmini → P10/P50/P90 belirsizlik bandı. Band, anomali
# motorunun hava belirsizliğini arıza sanmasını engeller. Kapatmak tahmini
# tek modelin insafına bırakır.
LM_TWIN_ENSEMBLE=true
# Boş bırakılırsa dört bağımsız merkez kullanılır (DWD, NOAA, ECMWF, Météo-France).
LM_TWIN_ENSEMBLE_MODELS=
# Haftalık kalibrasyon: gerçek/beklenen oranından tesis bazlı ölçek ve saatlik
# bias öğrenilir. Açık anomali pencereleri fit'ten dışlanır.
LM_TWIN_CALIBRATION_ENABLED=true
LM_TWIN_CALIBRATION_WINDOW_DAYS=14

# Auth (Faz 6)
# ⚠ İnternete açmadan önce: python -m luminmind.scripts.new_secrets
JWT_SECRET=changeme
JWT_ACCESS_TTL_MIN=30
# Seed admin parolası. Boş bırakılırsa "admin" olur — dışa açık kurulumda ASLA.
SEED_ADMIN_PASSWORD=

# --- Dışa açık çalıştırma (telefondan izleme) ---
# Panelin genel adresi. Doldurulduğu anda uygulama "internete açık" moda geçer:
# oturum çerezi Secure olur, HSTS açılır, host doğrulaması devreye girer.
# Boş bırakılırsa yerel HTTP geliştirme modunda kalır.
LM_PUBLIC_URL=
# LM_ENV=prod iken varsayılan sırlarla açılış reddedilir (kasıtlı güvenlik freni).
# LM_ENV=prod
# Panel oturum süresi (dk) — telefonda sürekli çıkış yapmamak için 1 gün.
LM_SESSION_TTL_MIN=1440
# Alan adınız yokken geçici tünel (trycloudflare) kullanıyorsanız: adres her
# yeniden başlatmada değiştiği için LM_PUBLIC_URL'i sabitleyemezsiniz. Bunun
# yerine çerez korumasını elle açıp host listesini joker ile verin:
#   LM_COOKIE_SECURE=true
#   LM_ALLOWED_HOSTS=*.trycloudflare.com
LM_COOKIE_SECURE=
LM_ALLOWED_HOSTS=
# Giriş deneme sınırı (parola deneme saldırısına karşı)
LM_LOGIN_MAX_ATTEMPTS=8
LM_LOGIN_WINDOW_MIN=15
# Cloudflare Tunnel token'ı (Zero Trust panelinden alınır).
# Doldurup `docker compose --profile public up -d` ile yayına alın.
CLOUDFLARE_TUNNEL_TOKEN=

# Üretici token şifreleme — Fernet anahtarı (Faz 2)
CREDENTIALS_ENC_KEY=changeme

# Üretici API'leri — mock modda boş bırakılabilir
LM_USE_MOCK_VENDORS=true
HUAWEI_BASE_URL=
HUAWEI_USERNAME=
HUAWEI_SYSTEM_CODE=
SMA_BASE_URL=
SMA_CLIENT_ID=
SMA_CLIENT_SECRET=

# --- Tescom UPS inverter API (İzmir fabrikası — gerçek PV verisi) ---
# Gerçek veriye geçmek için: LM_USE_MOCK_VENDORS=false yapın ve aşağıyı doldurun.
# Docker içinden host makinedeki 8503 portuna erişim için host.docker.internal kullanın
# (fabrika sunucusu ayrı bir IP ise onu yazın, ör. http://192.168.1.50:8503).
TESCOM_BASE_URL=
TESCOM_API_KEY=
# GES panel gücü (kWp). 0 bırakılırsa dijital ikiz beklenen üretimi hesaplamaz;
# gerçek değeri girince ikiz + anomali karşılaştırması devreye girer.
TESCOM_DC_CAPACITY_KWP=0
TESCOM_TIMEZONE=Europe/Istanbul
