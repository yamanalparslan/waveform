# Genel
LM_ENV=dev
LM_LOG_LEVEL=INFO

# PostgreSQL (Faz 2)
POSTGRES_PASSWORD=changeme
POSTGRES_DSN=postgresql+asyncpg://luminmind:changeme@postgres:5432/luminmind

# InfluxDB (Faz 2)
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=luminmind
INFLUX_TOKEN=changeme
INFLUX_PASSWORD=changeme123

# Redis / Celery
REDIS_URL=redis://redis:6379/0
INGESTION_INTERVAL_MINUTES=15

# Auth (Faz 6)
JWT_SECRET=changeme
JWT_ACCESS_TTL_MIN=30

# Üretici token şifreleme — Fernet anahtarı (Faz 2)
CREDENTIALS_ENC_KEY=changeme

# Üretici API'leri — mock modda boş bırakılabilir
LM_USE_MOCK_VENDORS=true
HUAWEI_BASE_URL=
HUAWEI_USERNAME=
HUAWEI_SYSTEM_CODE=
SMA_BASE_URL=
SMA_CLIENT_ID=
SMA_CLIENT_SECRET=
